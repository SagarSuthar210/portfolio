# Server Port
PORT=5000

# Razorpay Credentials (from your Razorpay Dashboard -> Settings -> API Keys)
# The same keys you used in BuilderHut!
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id_here
RAZORPAY_KEY_SECRET=your_actual_key_secret_here

# Frontend origin allowed for CORS
FRONTEND_URL=https://sagarsuthar210.github.io
